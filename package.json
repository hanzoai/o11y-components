{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "publint": "turbo run publint",
    "dev": "turbo run dev",
    "type-check": "tsgo --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "build-storybook": "turbo run build-storybook -- --output-dir=storybook-static",
    "chromatic": "pnpm install && pnpm build --filter=docs^... && turbo run chromatic --",
    "release": "turbo run build --filter=docs^...",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "baseline-browser-mapping": "catalog:",
    "fs-extra": "catalog:",
    "glob": "catalog:",
    "husky": "catalog:",
    "inquirer": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "sass": "catalog:",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-css-injected-by-js": "catalog:"
  },
  "resolutions": {
    "cross-spawn": "7.0.5",
    "esbuild": "0.25.0",
    "semver": ">=7.5.2",
    "tmp": "0.2.4"
  },
  "packageManager": "pnpm@10.30.3",
  "name": "design-system",
  "dependencies": {
    "@signozhq/design-tokens": "catalog:",
    "@signozhq/icons": "catalog:"
  },
  "version": "0.0.23"
}
